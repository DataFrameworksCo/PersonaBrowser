{
  "name": "persona-browser",
  "version": "1.3.0",
  "description": "Privacy-focused Chromium browser with persona isolation",
  "author": {
    "name": "Seth Floyd",
    "email": "thegoodcomputerco@gmail.com"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack --config webpack.renderer.config.js --watch --mode development",
    "dev:main": "wait-on dist/renderer/index.html && tsc --project tsconfig.main.json --watch & sleep 4 && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:main": "tsc --project tsconfig.main.json",
    "start": "electron . --no-sandbox",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "package:mac": "./scripts/package-mac.sh",
    "package:mac:dmg": "./scripts/package-mac-dmg.sh",
    "updates:serve": "node update-server.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.0",
    "playwright-core": "^1.60.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
